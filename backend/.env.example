PORT=3000
MONGODB_URI=mongodb://localhost:27017/sui-budget-control
FRONTEND_URL=http://localhost:4200
# Hosted CAAS One. For a locally running CAAS One instead use
# http://localhost:3500 and http://localhost:3501/api
CAAS_WEB_URL=https://one.caas-group.com
CAAS_API_URL=https://one-api.caas-group.com/api
CAAS_APP_KEY=sui-budget-control
SESSION_COOKIE_NAME=sbc_session
AUTH_CALLBACK_PUBLIC_URL=http://localhost:4200/api/auth/callback
MAX_UPLOAD_BYTES=20971520
NODE_ENV=development

# ─── Production (set these in the Vercel project, not in a file) ──────────────
# This file and .env are gitignored; the deployed API reads Vercel's own
# environment variables, so editing them here changes nothing in production.
#
#   FRONTEND_URL=https://sbc.caas-group.com
#   AUTH_CALLBACK_PUBLIC_URL=https://sbc.caas-group.com/api/auth/callback
#   CAAS_WEB_URL=https://one.caas-group.com
#   CAAS_API_URL=https://one-api.caas-group.com/api
#   MONGODB_URI=<the production cluster>
#   NODE_ENV=production
#
# AUTH_CALLBACK_PUBLIC_URL must be on the SITE's origin, not the API's own
# vercel.app host. The site proxies /api to the API (see web/vercel.json), so
# the session cookie is written as a first-party cookie on sbc.caas-group.com.
# Point it at sbc-api.vercel.app instead and the cookie lands on a different
# registrable domain, where Chrome will neither send it nor let it be cleared —
# which is a sign-in loop, and a sign-out that doesn't sign anyone out.
#
# The backend derives its cookie's SameSite from these two values, so getting
# them right is the whole configuration:
#   same origin  -> SameSite=Lax, first-party  (correct)
#   different    -> SameSite=None; Secure, third-party (blocked by Chrome)
